# Variables de entorno de la venta de entradas.
#
# Copiá este archivo a `.env.local` y completá los valores. `.env.local` está
# ignorado por git (`*.local` en .gitignore): NUNCA commitees credenciales.
#
# Para producción, las mismas variables van cargadas en Vercel:
#   vercel env add MP_ACCESS_TOKEN production
#
# ┌─ REGLA DEL PREFIJO ────────────────────────────────────────────────────────┐
# │ En Vite, TODO lo que empieza con `VITE_` se inlinea en el JavaScript que    │
# │ se descarga el navegador. Es público y cualquiera lo puede leer.           │
# │ Sólo `VITE_MP_PUBLIC_KEY` lleva ese prefijo, porque es la única pensada     │
# │ para ser pública. Si prefijás un secreto con `VITE_`, queda expuesto.       │
# └────────────────────────────────────────────────────────────────────────────┘

# ┌─ REGLA DEL ENTORNO ────────────────────────────────────────────────────────┐
# │ Todo lo que tiene dos caras se nombra igual, con `TEST_` metido después del │
# │ servicio. `ENTORNO` elige cuál se lee, y no hay mezcla posible:             │
# │                                                                            │
# │   producción           desarrollo                                          │
# │   MP_ACCESS_TOKEN      MP_TEST_ACCESS_TOKEN                                │
# │   RESEND_API_KEY       RESEND_TEST_API_KEY                                 │
# │   PUERTA_PIN           PUERTA_TEST_PIN                                     │
# │   PUBLIC_SITE_URL      PUBLIC_TEST_SITE_URL                                │
# │                                                                            │
# │ Si en desarrollo falta la `_TEST_`, NO se cae a la de producción: corta y  │
# │ dice cuál falta. Ese silencio es el que costó $147.809.                    │
# │                                                                            │
# │ Supabase es la excepción a propósito: una sola base para los dos entornos. │
# │ Para no escribir en la de verdad está `npm run dev:local`, que apunta al   │
# │ Postgres de Docker sin tocar este archivo.                                 │
# └────────────────────────────────────────────────────────────────────────────┘

# === Entorno ================================================================
# Qué juego de credenciales se usa. Con `development` se cobra con las de prueba
# y NO se mueve un peso.
#
#   (sin poner)  → Vercel en producción usa production; todo lo demás,
#                  development. Un preview cae en development A PROPÓSITO: es
#                  donde se probó con el túnel y donde se gastaron $147.809
#                  reales con las credenciales de producción.
#   production   → cobra de verdad. Ponela a mano sólo para una compra de
#                  verificación, y sacala después.
#
# En desarrollo, una credencial `APP_USR-` hace fallar el checkout a propósito.
ENTORNO=development


# === Mercado Pago ===========================================================
# App "startupworldcupar" (1003572338407990).
# Credenciales en: https://www.mercadopago.com.ar/developers/panel/app
#
# Hay DOS juegos y no se mezclan. En el panel están las dos solapas:
# «Credenciales de producción» y «Credenciales de prueba».

# ── Producción (empiezan con APP_USR-) — COBRAN PLATA DE VERDAD ─────────────

# SECRETA. Crea preferencias y consulta pagos.
MP_ACCESS_TOKEN=

# Pública. La usa Wallet Brick en el navegador. La manda el servidor en la
# respuesta del checkout, así que cambiarla ya no exige redeployar.
MP_PUBLIC_KEY=

# SECRETA. Firma de los webhooks.
# Panel → tu app → Webhooks → Configurar notificación → revelar clave secreta.
# Sin esto no se puede distinguir una notificación real de una inventada.
MP_WEBHOOK_SECRET=

# ── Prueba (empiezan con TEST-) — no mueven un peso ─────────────────────────
# Son las que se usan en local y en los previews. Si faltan, el checkout
# devuelve 503 en vez de caer a las de producción: preferimos que no se pueda
# comprar antes que cobrarle a alguien sin querer.

MP_TEST_ACCESS_TOKEN=
MP_TEST_PUBLIC_KEY=
MP_TEST_WEBHOOK_SECRET=

# ID de la cuenta que cobra (collector id). Numérico.
MP_USER_ID=


# === Supabase ===============================================================
# Si creás el proyecto desde la integración de Vercel, estas dos ya te quedan
# cargadas en el proyecto de Vercel y sólo tenés que copiarlas acá para local.

SUPABASE_URL=

# SECRETA. Saltea las políticas RLS: acceso total a la base.
# Sólo en funciones serverless. Jamás en el cliente.
#
# Es la "secret key" del panel (Settings → API), la que empieza con `sb_secret_`.
# Antes se llamaba `service_role`; ese nombre también se acepta.
SUPABASE_SECRET_KEY=

# La "publishable key" NO se usa: la app entra siempre con la secret desde el
# servidor, y las tablas tienen RLS sin políticas, así que la pública no lee nada.

# SECRETA. Contraseña de la base del proyecto cloud.
# La app NO la usa: entra por la REST API con las dos de arriba. Ésta es para
# `supabase link` / `supabase db push` (correr las migraciones) y para psql.
# En el Supabase local la contraseña es `postgres`, en el puerto 54322.
SUPABASE_DB_PASSWORD=


# === Resend =================================================================
# Mail de confirmación con el QR de la entrada. https://resend.com/api-keys

# SECRETA.
RESEND_API_KEY=

# Remitente. El dominio tiene que estar verificado en Resend (SPF + DKIM).
# Mientras no lo esté, Resend sólo entrega a tu propia casilla.
RESEND_FROM="Startup World Cup Argentina <entradas@tu-dominio.com>"

# A dónde le contestan si responden el mail.
RESEND_REPLY_TO=startupwc.arg@gmail.com

# ── Desarrollo ──────────────────────────────────────────────────────────────
# Vacías = en desarrollo no sale ningún mail. Se avisa por consola y la compra
# sigue: la entrada se ve igual en el sitio. Es el default a propósito, porque
# probar el checkout no tiene por qué escribirle a nadie.
RESEND_TEST_API_KEY=
RESEND_TEST_FROM="Startup World Cup Argentina (dev) <onboarding@resend.dev>"
RESEND_TEST_REPLY_TO=


# === Puerta =================================================================
# La pantalla de acreditación (/puerta). Sin estas dos, el login devuelve 503 y
# la puerta no abre.

# SECRETA. El PIN que se le pasa al equipo de puerta el día del evento.
# Que sea LARGO: detrás está la lista completa de asistentes con sus mails y
# teléfonos. No es un PIN de cuatro dígitos.
#   openssl rand -base64 12
PUERTA_PIN=

# SECRETA. Firma el token de sesión del staff. Cambiarla desloguea a todos.
#   openssl rand -base64 32
PUERTA_SECRET=

# ── Desarrollo ──────────────────────────────────────────────────────────────
# Sin estas dos, en local el login devuelve 503. No hace falta que sean largas:
# la base de desarrollo no tiene los datos del evento… salvo que sí, porque
# Supabase no conmuta. Ver la regla de arriba.
PUERTA_TEST_PIN=
PUERTA_TEST_SECRET=


# === Venta propia ===========================================================
# ¿El sitio ofrece pagar con Mercado Pago, o manda todo a Startup Grind?
#
# NO lleva `TEST_`: no es una credencial, es una decisión de negocio, y en Vercel
# ya se le puede dar distinto valor por entorno. Lo normal es tenerla en `on` en
# Preview —para probar el flujo completo en un deploy real— y en `off` en
# Production hasta el día que se abre la venta.
#
# Apagada por omisión, a propósito: un deploy al que se le olvidó vende por el
# canal de siempre; al revés, cobra sin que nadie lo haya decidido.
#
#   off (o sin poner)  el botón lleva a Startup Grind y /api/checkout da 403
#   on                 el modal de Mercado Pago
VENTA_PROPIA=off


# === App ====================================================================
# URL pública del sitio. La usan las back_urls de Mercado Pago y el link que
# lleva adentro el QR.
#
# Si están vacías, `siteUrl()` cae a los headers del proxy: es lo que hace que
# un preview de Vercel ande sin configurar nada.
#   producción       → https://<tu-dominio>
PUBLIC_SITE_URL=

# Mercado Pago necesita una URL pública para las back_urls y el webhook, así
# que en local va el túnel y no localhost.
#   local con túnel  → https://<algo>.trycloudflare.com
PUBLIC_TEST_SITE_URL=
